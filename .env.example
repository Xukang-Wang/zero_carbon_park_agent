# zero_carbon_park_agent 环境变量配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API 配置（必填，否则使用 MockLLM 降级）
ZERO_CARBON_PARK_AGENT_LLM_API_KEY=your-api-key-here
ZERO_CARBON_PARK_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
ZERO_CARBON_PARK_AGENT_LLM_MODEL=deepseek-chat

# 数据库配置（可选，默认使用 SQLite）
# ZERO_CARBON_PARK_AGENT_DB_URL=sqlite:///data/zero_carbon_park_agent.db

# 服务配置（可选）
# ZERO_CARBON_PARK_AGENT_HOST=0.0.0.0
# ZERO_CARBON_PARK_AGENT_PORT=8000